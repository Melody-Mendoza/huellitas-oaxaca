meta {
  name: 22 - Reemplazar foto por PNG válida
  type: http
  seq: 22
}

patch {
  url: {{baseUrl}}/perfil/foto
  body: multipart-form
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  foto: @file() @contentType(image/png)
}

script:post-response {
  if (res.status === 200 && res.body?.fotoPerfil) {
    bru.setVar("fotoPerfilNueva", res.body.fotoPerfil);
  }
}

tests {
  test("devuelve 200", function() {
    expect(res.status).to.equal(200);
  });

  test("devuelve una URL PNG nueva", function() {
    expect(res.body.fotoPerfil).to.match(/^\/media\/perfiles\//);
    expect(res.body.fotoPerfil).to.match(/\.png$/);
    expect(res.body.fotoPerfil).to.not.equal(bru.getVar("fotoPerfilInicial"));
  });
}

docs {
  Selecciona manualmente un archivo PNG válido y diferente en el campo foto.
}
