meta {
  name: 30 - Eliminar foto nuevamente
  type: http
  seq: 30
}

delete {
  url: {{baseUrl}}/perfil/foto
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

tests {
  test("devuelve 200", function() {
    expect(res.status).to.equal(200);
  });

  test("mantiene la eliminación idempotente", function() {
    expect(res.body.fotoPerfil).to.equal(null);
  });
}
