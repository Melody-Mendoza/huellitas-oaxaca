meta {
  name: 01 - Registro válido
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/registro
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Mel",
    "apellidoPaterno": "Perez",
    "apellidoMaterno": "Reyes",
    "correo": "{{correoPrueba}}",
    "password": "{{passwordInicial}}",
    "telefono": "9511234567"
  }
}

tests {
  test("devuelve 201", function() {
    expect(res.status).to.equal(201);
  });
  
  test("registra un usuario activo", function() {
    expect(res.body.correo).to.equal(bru.getVar("correoPrueba"));
    expect(res.body.activo).to.equal(true);
    expect(res.body.rol.nombre).to.equal("USUARIO");
  });
}
