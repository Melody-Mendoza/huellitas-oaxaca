meta {
  name: 17 - Logout
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/auth/logout
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

tests {
  test("devuelve 200", function() {
    expect(res.status).to.equal(200);
  });

  test("confirma el cierre de sesión", function() {
    expect(res.body.mensaje).to.equal("Sesión cerrada correctamente");
  });
}
