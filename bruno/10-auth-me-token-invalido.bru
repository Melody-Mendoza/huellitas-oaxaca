meta {
  name: 10 - Auth Me con token inválido
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/auth/me
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: token-invalido
}

tests {
  test("devuelve 401", function() {
    expect(res.status).to.equal(401);
  });

  test("rechaza el token inválido", function() {
    expect(res.body.message).to.equal("Debes iniciar sesión para acceder a este recurso");
  });
}
