meta {
  name: Usuario intenta listar administración VPS
  type: http
}

get {
  url: {{baseUrlVps}}/api/admin/usuarios?page=0&size=10
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenUsuario}}
}

script:post-response {
  if (res.getStatus() !== 403) throw new Error("Se esperaba HTTP 403");
}
