meta {
  name: 26 - Archivo vacío
  type: http
  seq: 26
}

patch {
  url: {{baseUrl}}/perfil/foto
  body: multipart-form
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  foto: @file() @contentType(image/jpeg)
}

tests {
  test("devuelve 400", function() {
    expect(res.status).to.equal(400);
  });

  test("rechaza el archivo vacío", function() {
    expect(res.body.message).to.equal("La foto no puede estar vacía");
  });
}

docs {
  Selecciona manualmente un archivo de cero bytes en el campo foto.
}
