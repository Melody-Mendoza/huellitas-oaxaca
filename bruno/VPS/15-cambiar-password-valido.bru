meta {
  name: NO EJECUTAR - 15 - Cambiar contraseña válido
  type: http
  seq: 15
}

patch {
  url: {{baseUrl}}/perfil/password
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "passwordActual": "{{passwordInicial}}",
    "nuevaPassword": "{{passwordNueva}}",
    "confirmarPassword": "{{passwordNueva}}"
  }
}

tests {
  test("devuelve 200", function() {
    expect(res.status).to.equal(200);
  });
  test("incluye confirmación", function() {
    expect(res.body.mensaje).to.be.a("string").and.not.empty;
  });
}

docs {
  Cambia credenciales. No ejecutar automáticamente en VPS.
}
