meta {
  name: PELIGRO - 30 - Eliminar foto nuevamente
  type: http
  seq: 30
}

delete {
  url: {{baseUrl}}/perfil/foto
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{authToken}}
}

tests {
  test("devuelve 200", function() {
    expect(res.status).to.equal(200);
  });
  test("mantiene foto nula", function() {
    expect(res.body.fotoPerfil).to.equal(null);
  });
}

docs {
  PELIGRO: solicitud DELETE. No ejecutar en VPS sin autorización expresa.
}
