meta {
  name: 11 - Actualizar perfil - Teléfono inválido controlado
  type: http
  seq: 11
}

put {
  url: {{baseUrl}}/perfil
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "nombre": "Usuario",
    "apellidoPaterno": "Demostracion",
    "apellidoMaterno": "VPS",
    "telefono": "95112ABC"
  }
}

tests {
  test("devuelve 400", function() {
    expect(res.status).to.equal(400);
  });
  test("incluye error de teléfono", function() {
    expect(res.body.validationErrors.telefono).to.be.a("string").and.not.empty;
  });
}
