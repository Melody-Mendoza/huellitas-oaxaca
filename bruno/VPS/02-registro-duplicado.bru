meta {
  name: NO EJECUTAR - 02 - Registro duplicado
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/registro
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Usuario",
    "apellidoPaterno": "Demostracion",
    "apellidoMaterno": "VPS",
    "correo": "{{correoPrueba}}",
    "password": "{{passwordInicial}}",
    "telefono": "9511234567"
  }
}

tests {
  test("devuelve 422", function() {
    expect(res.status).to.equal(422);
  });
  test("incluye mensaje", function() {
    expect(res.body.message).to.be.a("string").and.not.empty;
  });
}

docs {
  Requiere que el usuario de demostración ya exista. No ejecutar automáticamente.
}
