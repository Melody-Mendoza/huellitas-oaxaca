meta {
  name: 12 - Cambiar contraseña - Actual incorrecta
  type: http
  seq: 12
}

patch {
  url: {{baseUrl}}/perfil/password
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "passwordActual": "{{passwordNueva}}",
    "nuevaPassword": "{{passwordNueva}}",
    "confirmarPassword": "{{passwordNueva}}"
  }
}

tests {
  test("devuelve 422", function() {
    expect(res.status).to.equal(422);
  });
  test("incluye mensaje", function() {
    expect(res.body.message).to.be.a("string").and.not.empty;
  });
}
