meta {
  name: 04 - Login JSON malformado
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/auth/login
  body: text
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:text {
  {"correo":"{{correoPrueba}}","password":
}

tests {
  test("devuelve 400", function() {
    expect(res.status).to.equal(400);
  });
  test("incluye mensaje", function() {
    expect(res.body.message).to.be.a("string").and.not.empty;
  });
}
