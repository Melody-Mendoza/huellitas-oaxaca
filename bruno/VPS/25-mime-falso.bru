meta {
  name: 25 - MIME falso
  type: http
  seq: 25
}

patch {
  url: {{baseUrl}}/perfil/foto
  body: multipart-form
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:multipart-form {
  foto: @file() @contentType(image/jpeg)
}

tests {
  test("devuelve 415", function() {
    expect(res.status).to.equal(415);
  });
  test("incluye mensaje", function() {
    expect(res.body.message).to.be.a("string").and.not.empty;
  });
}

docs {
  Selecciona un PNG de demostración renombrado como JPG. No usar archivos reales.
}
