meta {
  name: 23 - Consultar foto reemplazada
  type: http
  seq: 23
}

get {
  url: {{baseUrl}}/perfil
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{authToken}}
}

tests {
  test("devuelve 200", function() {
    expect(res.status).to.equal(200);
  });
  test("devuelve el campo de foto", function() {
    expect(res.body).to.have.property("fotoPerfil");
  });
}
