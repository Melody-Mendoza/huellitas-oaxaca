meta {
  name: NO EJECUTAR - 44 - Cambiar contraseña de cuenta sólo Google
  type: http
  seq: 44
}

patch {
  url: {{baseUrl}}/perfil/password
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{googleAuthToken}}
}

body:json {
  {
    "passwordActual": "{{passwordInicial}}",
    "nuevaPassword": "{{passwordNueva}}",
    "confirmarPassword": "{{passwordNueva}}"
  }
}

tests {
  test("devuelve 422", function() {
    expect(res.status).to.equal(422);
  });
  test("explica que no existe contraseña local", function() {
    expect(res.body.message).to.equal("Esta cuenta no tiene una contraseña local");
  });
}

docs {
  Configura googleAuthToken sólo como secreto de una cuenta de demostración con tienePasswordLocal=false.
}
