meta {
  name: 36 - Consultar usuario por ID - ADMIN
  type: http
  seq: 36
}

get {
  url: {{baseUrl}}/usuarios/{{usuarioId}}
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("devuelve 200", function() {
    expect(res.status).to.equal(200);
  });
  test("devuelve usuario sin contraseña", function() {
    expect(res.body.id).to.exist;
    expect(res.body).to.not.have.property("password");
    expect(res.body).to.not.have.property("firebaseUid");
    expect(res.body.tienePasswordLocal).to.be.a("boolean");
  });
}
