meta {
  name: 26 - Archivo de foto vacío
  type: http
  seq: 26
}

patch {
  url: {{baseUrl}}/perfil/foto
  body: multipart-form
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:multipart-form {
  foto: @file() @contentType(image/jpeg)
}

tests {
  test("devuelve 400", function() {
    expect(res.status).to.equal(400);
  });
  test("incluye mensaje", function() {
    expect(res.body.message).to.be.a("string").and.not.empty;
  });
}

docs {
  Selecciona un archivo de cero bytes.
}
