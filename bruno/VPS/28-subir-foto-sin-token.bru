meta {
  name: 28 - Subir foto sin token
  type: http
  seq: 28
}

patch {
  url: {{baseUrl}}/perfil/foto
  body: multipart-form
  auth: none
}

headers {
  Accept: application/json
}

body:multipart-form {
  foto: @file() @contentType(image/jpeg)
}

tests {
  test("devuelve 401", function() {
    expect(res.status).to.equal(401);
  });
  test("incluye mensaje", function() {
    expect(res.body.message).to.be.a("string").and.not.empty;
  });
}

docs {
  Selecciona un JPEG de demostración; no envía autenticación.
}
