meta {
  name: 33 - Recuperar contraseña
  type: http
  seq: 33
}

post {
  url: {{baseUrl}}/auth/recuperar-password
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "correo": "usuario-inexistente@example.invalid"
  }
}

tests {
  test("devuelve 200", function() {
    expect(res.status).to.equal(200);
  });
  test("incluye mensaje genérico", function() {
    expect(res.body.mensaje).to.be.a("string").and.not.empty;
  });
}

docs {
  Usa deliberadamente un dominio reservado para no afectar cuentas reales.
}
