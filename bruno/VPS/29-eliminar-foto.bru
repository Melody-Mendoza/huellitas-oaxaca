meta {
  name: PELIGRO - 29 - Eliminar foto
  type: http
  seq: 29
}

delete {
  url: {{baseUrl}}/perfil/foto
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{authToken}}
}

tests {
  test("devuelve 200", function() {
    expect(res.status).to.equal(200);
  });
  test("elimina la referencia de foto", function() {
    expect(res.body.fotoPerfil).to.equal(null);
  });
}

docs {
  PELIGRO: elimina la foto del perfil autenticado. No ejecutar en VPS sin autorización expresa.
}
