meta {
  name: 43 - Listar usuarios sin token
  type: http
  seq: 43
}

get {
  url: {{baseUrl}}/usuarios
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("devuelve 401", function() {
    expect(res.status).to.equal(401);
  });
  test("devuelve error JSON consistente", function() {
    expect(res.body.message).to.equal("Debes iniciar sesión para acceder a este recurso");
  });
}
