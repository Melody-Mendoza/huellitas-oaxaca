meta {
  name: 10 - Auth Me con token inválido
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/auth/me
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: token-invalido-controlado
}

tests {
  test("devuelve 401", function() {
    expect(res.status).to.equal(401);
  });
  test("incluye mensaje", function() {
    expect(res.body.message).to.be.a("string").and.not.empty;
  });
}
