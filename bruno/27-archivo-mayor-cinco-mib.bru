meta {
  name: 27 - Archivo mayor de 5 MiB
  type: http
  seq: 27
}

patch {
  url: {{baseUrl}}/perfil/foto
  body: multipart-form
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  foto: @file() @contentType(image/jpeg)
}

tests {
  test("devuelve 413", function() {
    expect(res.status).to.equal(413);
  });

  test("informa el límite permitido", function() {
    expect(res.body.message).to.equal("La foto no debe superar 5 MiB");
  });
}

docs {
  Selecciona manualmente un archivo mayor de 5 MiB en el campo foto.
}
