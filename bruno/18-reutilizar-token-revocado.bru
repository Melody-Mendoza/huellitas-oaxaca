meta {
  name: 18 - Reutilizar token revocado
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/auth/me
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

tests {
  test("devuelve 401", function() {
    expect(res.status).to.equal(401);
  });

  test("rechaza el token revocado", function() {
    expect(res.body.message).to.equal("Debes iniciar sesión para acceder a este recurso");
  });
}
