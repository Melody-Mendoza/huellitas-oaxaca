meta {
  name: 24 - Tipo no permitido
  type: http
  seq: 24
}

patch {
  url: {{baseUrl}}/perfil/foto
  body: multipart-form
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:multipart-form {
  foto: @file() @contentType(text/plain)
}

tests {
  test("devuelve 415", function() {
    expect(res.status).to.equal(415);
  });

  test("explica los tipos permitidos", function() {
    expect(res.body.message).to.equal("El tipo de archivo no está permitido. Usa JPEG o PNG");
  });
}

docs {
  Selecciona manualmente un archivo TXT en el campo foto.
}
