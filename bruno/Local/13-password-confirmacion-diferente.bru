meta {
  name: 13 - Cambiar contraseña - Confirmación diferente
  type: http
  seq: 13
}

patch {
  url: {{baseUrl}}/perfil/password
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "passwordActual": "{{passwordInicial}}",
    "nuevaPassword": "{{passwordNueva}}",
    "confirmarPassword": "{{passwordInicial}}"
  }
}

tests {
  test("devuelve 422", function() {
    expect(res.status).to.equal(422);
  });

  test("rechaza contraseñas nuevas diferentes", function() {
    expect(res.body.message).to.equal("Las contraseñas nuevas no coinciden");
  });
}
