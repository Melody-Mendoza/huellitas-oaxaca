meta {
  name: 20 - Subir foto JPEG válida
  type: http
  seq: 20
}

patch {
  url: {{baseUrl}}/perfil/foto
  body: multipart-form
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:multipart-form {
  foto: @file() @contentType(image/jpeg)
}

script:post-response {
  if (res.status === 200 && res.body?.fotoPerfil) {
    bru.setVar("fotoPerfilInicial", res.body.fotoPerfil);
  }
}

tests {
  test("devuelve 200", function() {
    expect(res.status).to.equal(200);
  });

  test("devuelve y guarda la URL JPEG", function() {
    expect(res.body.fotoPerfil).to.be.a("string");
    expect(res.body.fotoPerfil).to.match(/^\/media\/perfiles\//);
    expect(res.body.fotoPerfil).to.match(/\.jpg$/);
  });
}

docs {
  Selecciona manualmente un archivo JPEG válido en el campo foto antes de ejecutar.
}
