meta {
  name: PELIGRO - 38 - Cambiar estado de usuario - ADMIN
  type: http
  seq: 38
}

patch {
  url: {{baseUrl}}/usuarios/{{usuarioId}}/estado
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "activo": false
  }
}

tests {
  test("devuelve 200", function() {
    expect(res.status).to.equal(200);
  });
  test("devuelve el estado solicitado", function() {
    expect(res.body.activo).to.equal(false);
  });
}

docs {
  PELIGRO: desactiva un usuario. Ejecutar sólo con un registro de prueba y autorización expresa.
}
