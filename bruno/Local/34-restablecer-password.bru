meta {
  name: NO EJECUTAR - 34 - Restablecer contraseña
  type: http
  seq: 34
}

post {
  url: {{baseUrl}}/auth/restablecer-password
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "token": "{{recoveryToken}}",
    "nuevaPassword": "{{passwordNueva}}",
    "confirmarPassword": "{{passwordNueva}}"
  }
}

tests {
  test("devuelve éxito o rechazo controlado", function() {
    expect([200, 400, 401, 422]).to.include(res.status);
  });
}

docs {
  Cambia credenciales si recoveryToken es válido. No ejecutar sin una cuenta de prueba controlada.
}
