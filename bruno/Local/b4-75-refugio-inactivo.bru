meta {
  name: B4 - 75 - Refugio inactivo
  type: http
  seq: 75
}

get {
  url: {{baseUrl}}/mascotas/{{mascotaRefugioInactivoId}}
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("no publica mascotas de refugios inactivos", function() {
    expect(res.status).to.equal(404);
    expect(res.body.message).to.equal("No se encontró la mascota solicitada");
  });
}
