meta {
  name: B4 - 76 - Mascota sin refugio
  type: http
  seq: 76
}

get {
  url: {{baseUrl}}/mascotas/{{mascotaSinRefugioId}}
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("no publica mascotas sin refugio", function() {
    expect(res.status).to.equal(404);
    expect(res.body.message).to.equal("No se encontró la mascota solicitada");
  });
}
