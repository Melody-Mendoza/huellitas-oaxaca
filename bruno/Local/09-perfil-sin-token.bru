meta {
  name: 09 - Perfil sin token
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/perfil
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("devuelve 401", function() {
    expect(res.status).to.equal(401);
  });

  test("solicita iniciar sesión", function() {
    expect(res.body.message).to.equal("Debes iniciar sesión para acceder a este recurso");
  });
}
