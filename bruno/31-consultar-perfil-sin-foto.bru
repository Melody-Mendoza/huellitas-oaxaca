meta {
  name: 31 - Consultar perfil sin foto
  type: http
  seq: 31
}

get {
  url: {{baseUrl}}/perfil
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

tests {
  test("devuelve 200", function() {
    expect(res.status).to.equal(200);
  });

  test("devuelve el perfil autenticado sin foto", function() {
    expect(res.body.fotoPerfil).to.equal(null);
    expect(res.body.correo).to.equal(bru.getVar("correoPrueba"));
  });
}
