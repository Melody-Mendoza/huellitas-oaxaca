meta {
  name: 15 - Cambiar contraseña válido
  type: http
  seq: 15
}

patch {
  url: {{baseUrl}}/perfil/password
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "passwordActual": "{{passwordInicial}}",
    "nuevaPassword": "{{passwordNueva}}",
    "confirmarPassword": "{{passwordNueva}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("passwordInicial", bru.getVar("passwordNueva"));
  }
}

tests {
  test("devuelve 200", function() {
    expect(res.status).to.equal(200);
  });

  test("confirma el cambio de contraseña", function() {
    expect(res.body.mensaje).to.equal("La contraseña se actualizó correctamente");
  });
}
